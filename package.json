{
  "name": "rhaomi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:contracts && npm run test:unit",
    "test:contracts": "node --test tests/*.test.mjs",
    "test:orchestration": "vitest run src/build-orchestration",
    "test:transformer": "vitest run src/build-transformer",
    "test:unit": "vitest run",
    "prepare:publication-staging": "node scripts/prepare-publication-staging.mts",
    "transform:snapshot": "node scripts/transform-build-snapshot.mts",
    "validate:export": "node scripts/validate-export.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
