# 이 파일을 .env.dev.local로 복사한 뒤 local 개발 전용 값으로 교체합니다.
# 아래 값은 형식 예시이며 운영 credential로 사용하지 않습니다.

POSTGRES_DB=rhaomi_dev
POSTGRES_USER=rhaomi_dev
POSTGRES_PASSWORD=replace-with-a-random-local-password

# local/test bootstrap은 명시적으로 활성화하고 두 값을 모두 채운 경우에만 동작합니다.
RHAOMI_BOOTSTRAP_ADMIN_ENABLED=false
RHAOMI_BOOTSTRAP_ADMIN_EMAIL=
RHAOMI_BOOTSTRAP_ADMIN_PASSWORD=

# local HTTP에서는 false, TLS를 사용하는 production에서는 반드시 true입니다.
RHAOMI_SESSION_COOKIE_SECURE=false

# backend private media master의 container 내부 local 개발 경로입니다.
RHAOMI_MEDIA_ROOT=/var/lib/rhaomi/media
