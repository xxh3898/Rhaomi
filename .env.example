# 이 파일을 .env.dev.local로 복사한 뒤 local 개발 전용 값으로 교체합니다.
# 아래 값은 형식 예시이며 운영 credential로 사용하지 않습니다.

POSTGRES_DB=rhaomi_dev
POSTGRES_USER=rhaomi_dev
POSTGRES_PASSWORD=replace-with-a-random-local-password

DIRECTUS_SECRET=replace-with-at-least-32-random-characters-for-local-only
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-random-local-password
DIRECTUS_PUBLIC_URL=http://localhost:8055
